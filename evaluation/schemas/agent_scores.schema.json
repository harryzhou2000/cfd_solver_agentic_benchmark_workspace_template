{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent-driven evaluation scores for a contestant snapshot",
  "type": "object",
  "required": ["schema", "contestant", "evaluated_at", "scores", "rubric"],
  "properties": {
    "schema": { "enum": ["agent_scores"] },
    "contestant": { "type": "string" },
    "evaluated_at": { "type": "string" },
    "evaluator": {
      "type": "object",
      "properties": {
        "agent": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "harness": { "enum": ["codex", "opencode", "unknown"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "metadata_answers": { "type": "object" },
    "session_selection": {
      "type": "object",
      "properties": {
        "source": { "enum": ["system", "project", "all", "unknown"] },
        "roots": { "type": ["array", "null"], "items": { "type": "string" } },
        "rationale": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "code_review": { "$ref": "#/definitions/area" },
        "cfd_review": { "$ref": "#/definitions/area" },
        "result_review": { "$ref": "#/definitions/area" }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["total_possible", "total_scored", "sections"],
      "properties": {
        "total_possible": { "type": "integer" },
        "total_scored": { "type": ["number", "null"] },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "max_points", "score", "notes"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "max_points": { "type": "number" },
              "score": { "type": ["number", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "disqualification": {
      "type": "object",
      "properties": {
        "triggered": { "type": "boolean" },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "text": { "type": "string" },
              "evidence": { "type": ["string", "null"] },
              "found": { "type": "boolean" }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "area": {
      "type": "object",
      "required": ["points", "overall_score"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "score"],
            "properties": {
              "id": { "type": "string" },
              "score": { "type": ["number", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "overall_score": { "type": ["number", "null"] },
        "disqualification_flags": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
