{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent-driven evaluation scores for a contestant snapshot",
  "type": "object",
  "required": ["schema", "contestant", "evaluated_at", "scores", "rubric"],
  "properties": {
    "schema": { "enum": ["agent_scores"] },
    "contestant": { "type": "string" },
    "evaluated_at": { "type": "string" },
    "evaluator": {
      "type": "object",
      "properties": {
        "agent": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "harness": { "enum": ["codex", "opencode", "unknown"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "metadata_answers": { "type": "object" },
    "session_selection": {
      "type": "object",
      "properties": {
        "source": { "enum": ["system", "project", "all", "unknown"] },
        "roots": { "type": ["array", "null"], "items": { "type": "string" } },
        "execution_date": {
          "type": ["string", "null"],
          "description": "UTC calendar date (YYYY-MM-DD) of the selected primary run's start"
        },
        "started_at": { "type": ["string", "null"] },
        "ended_at": { "type": ["string", "null"] },
        "time_basis": { "type": ["string", "null"] },
        "contestant_final_response_status": {
          "enum": ["present", "absent", "unknown"]
        },
        "contestant_final_response_absence_reason": { "type": ["string", "null"] },
        "rationale": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "code_review": { "$ref": "#/definitions/area" },
        "cfd_review": { "$ref": "#/definitions/area" },
        "result_review": { "$ref": "#/definitions/area" }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["total_possible", "total_scored", "sections"],
      "properties": {
        "total_possible": { "type": "integer" },
        "total_scored": { "type": ["number", "null"] },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "max_points", "score", "notes"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "max_points": { "type": "number" },
              "score": { "type": ["number", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "case_scores": {
      "type": "object",
      "description": "Independent 0-5 assessment of each required benchmark case; not included in review-area or 100-point rubric totals.",
      "additionalProperties": false,
      "required": [
        "naca0012_m015_inviscid",
        "naca0012_m080_inviscid",
        "naca0012_m200_inviscid",
        "naca0012_m015_laminar_re5000",
        "naca0012_m080_laminar_re5000",
        "naca0012_m200_laminar_re5000",
        "cylinder_m010_laminar_re20",
        "cylinder_m010_laminar_re200"
      ],
      "properties": {
        "naca0012_m015_inviscid": { "$ref": "#/definitions/case_score" },
        "naca0012_m080_inviscid": { "$ref": "#/definitions/case_score" },
        "naca0012_m200_inviscid": { "$ref": "#/definitions/case_score" },
        "naca0012_m015_laminar_re5000": { "$ref": "#/definitions/case_score" },
        "naca0012_m080_laminar_re5000": { "$ref": "#/definitions/case_score" },
        "naca0012_m200_laminar_re5000": { "$ref": "#/definitions/case_score" },
        "cylinder_m010_laminar_re20": { "$ref": "#/definitions/case_score" },
        "cylinder_m010_laminar_re200": { "$ref": "#/definitions/case_score" }
      }
    },
    "disqualification": {
      "type": "object",
      "properties": {
        "triggered": { "type": "boolean" },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "text": { "type": "string" },
              "evidence": { "type": ["string", "null"] },
              "found": { "type": "boolean" }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "case_score": {
      "type": "object",
      "required": ["score", "notes"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 5 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "area": {
      "type": "object",
      "required": ["points", "overall_score"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "score"],
            "properties": {
              "id": { "type": "string" },
              "score": { "type": ["number", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "overall_score": { "type": ["number", "null"] },
        "disqualification_flags": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
