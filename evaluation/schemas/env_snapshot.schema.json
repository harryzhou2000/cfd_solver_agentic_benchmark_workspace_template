{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Environment snapshot for a contestant run",
  "type": "object",
  "required": ["schema", "version", "captured_at", "host", "tools", "environment", "workspace"],
  "properties": {
    "schema": { "enum": ["env_snapshot"] },
    "version": { "type": "string" },
    "capture_phase": { "enum": ["pre_run", "post_run"] },
    "run_environment_available": { "type": "boolean" },
    "runtime_at_run": {
      "type": "object",
      "required": ["availability", "harness_version", "container_image"],
      "properties": {
        "availability": { "enum": ["captured", "unavailable"] },
        "harness_version": { "type": ["string", "null"] },
        "container_image": { "type": ["string", "null"] }
      }
    },
    "captured_at": { "type": "string" },
    "local_time": { "type": "string" },
    "host": {
      "type": "object",
      "properties": {
        "hostname": { "type": "string" },
        "os": { "type": "string" },
        "machine": { "type": "string" },
        "python": { "type": "string" },
        "cpus": { "type": ["integer", "null"] },
        "memory_gb": { "type": ["number", "null"] },
        "loadavg_1_5_15": { "type": ["array", "null"], "items": { "type": "string" } },
        "in_docker": { "type": "boolean" },
        "docker": { "type": ["object", "null"] }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "installed": { "type": "boolean" },
          "path": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] }
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "vars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "set": { "type": "boolean" },
              "value": { "type": "string" },
              "credential": { "type": "boolean" }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "proxy_env": { "type": "array", "items": { "type": "object" } },
        "note": { "type": "string" }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "git_dirty": { "type": "boolean" },
        "dirty_files": { "type": "integer" },
        "agents_md_sha256": { "type": ["string", "null"] },
        "codegraph": { "type": "boolean" },
        "done_marker": { "type": "boolean" },
        "external_symlink": { "type": ["string", "null"] },
        "benchmark_submodule": {
          "type": "object",
          "properties": {
            "exists": { "type": "boolean" },
            "commit": { "type": ["string", "null"] },
            "branch": { "type": ["string", "null"] }
          }
        },
        "state_timing": { "enum": ["initial_observed_pre_run", "initial_reconstructed_post_run"] }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "script": { "type": "string" },
        "script_version": { "type": "string" },
        "reconstruction_sources": { "type": "array", "items": { "type": "string" } },
        "captured_workspace_state": { "type": ["object", "null"] },
        "initial_branch_detection": {
          "type": ["object", "null"],
          "properties": {
            "canonical_branch": { "type": "string" },
            "commit": { "type": "string" },
            "selected_ref": { "type": "string" },
            "source": { "enum": ["local", "remote_tracking"] },
            "symbolic_head": { "type": ["string", "null"] },
            "candidate_refs": { "type": "array", "items": { "type": "object" } },
            "explicit_expected_branch": { "type": ["string", "null"] }
          }
        },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "capture_phase": { "const": "post_run" } }, "required": ["capture_phase"] },
      "then": {
        "properties": {
          "run_environment_available": { "const": false },
          "runtime_at_run": {
            "properties": {
              "availability": { "const": "unavailable" },
              "harness_version": { "type": "null" },
              "container_image": { "type": "null" }
            }
          },
          "workspace": { "properties": { "state_timing": { "const": "initial_reconstructed_post_run" } } }
        },
        "required": ["run_environment_available", "runtime_at_run"]
      }
    }
  ]
}
