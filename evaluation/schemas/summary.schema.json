{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Benchmark contestant final result summary",
  "type": "object",
    "required": ["contestant", "expenses", "code_review", "cfd_review", "result_review", "measurements", "metadata", "provenance"],
  "properties": {
    "contestant": {
      "type": "object",
      "required": ["workspace", "branch", "git_commit", "benchmark_submodule_commit", "layout"],
      "properties": {
        "workspace": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "git_commit": { "type": ["string", "null"] },
        "benchmark_submodule_commit": { "type": ["string", "null"] },
        "layout": { "enum": ["standard", "non_standard", "unknown"] },
        "solver_dir": { "type": ["string", "null"] },
        "results_dir": { "type": ["string", "null"] },
        "report_dir": { "type": ["string", "null"] },
        "session_window": {
          "type": "object",
          "properties": {
            "start": { "type": ["string", "null"] },
            "end": { "type": ["string", "null"] }
          }
        }
      }
    },
    "expenses": {
      "type": "object",
      "required": ["time_seconds", "tokens", "cost_estimate_usd"],
      "properties": {
        "time_seconds": {
          "type": "object",
          "properties": {
            "goal_time": { "type": "number" },
            "wall_time": { "type": "number" },
            "by_root_thread": { "type": "object" },
            "by_root_tree": {
              "type": "object",
              "description": "Per root session: status, model, thread count, token total, goal time. Makes botched/abandoned sessions visible and separable via --roots.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": { "type": ["string", "null"] },
                  "goal_time_seconds": { "type": "number" },
                  "goal_tokens": { "type": "integer" },
                  "threads": { "type": "integer" },
                  "tokens_used": { "type": "integer" },
                  "model": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "tokens": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "by_model": { "type": "object" },
            "by_thread": { "type": "object" },
            "main_vs_subagent": { "type": "object" },
            "discrepancy_notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "cost_estimate_usd": {
          "type": "object",
          "properties": {
            "total": { "type": "number" },
            "by_model": { "type": "object" },
            "unpriced_tokens": { "type": "integer" },
            "estimate": { "type": "boolean" },
            "metadata": { "type": "string" }
          }
        }
      }
    },
    "code_review": { "$ref": "#/definitions/review" },
    "cfd_review": { "$ref": "#/definitions/review" },
    "result_review": { "$ref": "#/definitions/review" },
    "measurements": {
      "type": "object",
      "required": ["tool_usage", "loc", "rule_violations"],
      "properties": {
        "tool_usage": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "by_tool": { "type": "object" },
            "by_thread": { "type": "object" },
            "subagent_spawns": { "type": "integer" },
            "risk_context": { "type": "array", "items": { "type": "object" } }
          }
        },
        "loc": {
          "type": "object",
          "properties": {
            "method": { "type": "string" },
            "git": { "type": ["object", "null"] },
            "file": { "type": ["object", "null"] }
          }
        },
        "rule_violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "severity", "thread_id", "timestamp", "tool"],
            "properties": {
              "category": { "type": "string" },
              "severity": { "enum": ["high", "medium", "low"] },
              "thread_id": { "type": "string" },
              "timestamp": { "type": ["string", "null"] },
              "tool": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["harness", "models", "context", "subagents", "prompts"],
      "properties": {
        "harness": {
          "type": "object",
          "properties": {
            "harness": { "type": "string" },
            "cli_version": { "type": ["string", "null"] },
            "originator": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"] },
            "thread_source": { "type": ["string", "null"] },
            "multi_agent_version": { "type": ["string", "null"] },
            "history_mode": { "type": ["string", "null"] },
            "memory_mode": { "type": ["string", "null"] },
            "model_provider": { "type": ["string", "null"] },
            "codex_runtime_version": { "type": ["string", "null"] },
            "plugins": { "type": "array", "items": { "type": "object" } }
          }
        },
        "models": { "type": "object" },
        "context": { "type": "object" },
        "subagents": { "type": "array", "items": { "type": "object" } },
        "opencodex": { "type": ["object", "null"] },
        "opencode": { "type": ["object", "null"] },
        "prompts": { "type": "object" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "question", "reason", "suggested_source", "answer"],
            "properties": {
              "id": { "type": "string" },
              "question": { "type": "string" },
              "reason": { "type": "string" },
              "suggested_source": { "type": "string" },
              "answer": { "type": ["string", "null"] }
            }
          }
        },
        "user_answers": { "type": "object" },
        "status": { "enum": ["complete", "needs_user_input"] }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "state_db": { "type": "string" },
        "goals_db": { "type": "string" },
        "logs_db": { "type": "string" },
        "sessions_root": { "type": "string" },
        "generated_at": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "review": {
      "type": "object",
      "required": ["points", "overall_score"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "weight", "score"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "weight": { "type": "number" },
              "score": { "type": ["number", "null"] },
              "notes": { "type": "string" }
            }
          }
        },
        "overall_score": { "type": ["number", "null"] },
        "disqualification_flags": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
