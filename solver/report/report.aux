\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-rank partition diagnostics for \texttt  {naca0012\_m015\_inviscid} (8 ranks, 20816 owned cells total). Load-balance ratio (max/mean owned) $=1.028$; ghost cells per rank are the one-cell halo used for reconstruction and residuals.}}{29}{table.caption.53}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-rank partition diagnostics for \texttt  {cylinder\_m010\_laminar\_re20} (2 ranks, 10185 owned cells total). Load-balance ratio (max/mean owned) $=1.008$; ghost cells per rank are the one-cell halo used for reconstruction and residuals.}}{29}{table.caption.54}\protected@file@percent }
